# JARVIS 2 - Multi-API Configuration

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@localhost:5432/jarvis2

# ===== ONDA TRADING (Forex/Gold - Primary for XAUUSD) =====
# Get from: https://www.onda.trading/
ONDA_API_KEY=your_onda_api_key
ONDA_ACCESS_TOKEN=your_onda_access_token

# ===== DHANAQ (Forex/Commodities/Gold - Fallback) =====
# Get from: https://www.dhanhq.co/
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# ===== TRADING CONFIG =====
PAPER_TRADING_ENABLED=True
INITIAL_CAPITAL=500000.0

# Agent Allocations
ALLOCATION_STOCKS=100000.0
ALLOCATION_SENSEX=100000.0
ALLOCATION_OPTIONS=100000.0
ALLOCATION_CANDLE=100000.0
ALLOCATION_XAUUSD=100000.0

# ===== APP CONFIG =====
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-value
CORS_ORIGINS=["*"]
